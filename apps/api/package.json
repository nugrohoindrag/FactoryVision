{
  "name": "@fv/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "start:prod": "node server.mjs",
    "build": "prisma generate && tsc --outDir dist --noEmit false",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@fastify/static": "^7.0.4",
    "@fv/contracts": "workspace:*",
    "@fv/domain": "workspace:*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-fastify": "^10.4.22",
    "@prisma/client": "^6.19.3",
    "big.js": "^6.2.2",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "jose": "^6.2.8",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.12",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.6",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.19.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
